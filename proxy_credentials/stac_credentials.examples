{
    "_comment": "STAC API Credentials (FSDI) - Vorlage, Aufbau wie topo-rapidmapping-int",
    "_instructions": [
        "1. Diese Datei nach secrets\\stac_credentials.json kopieren",
        "2. Platzhalter durch die echten Zugangsdaten ersetzen",
        "3. NIEMALS committen - secrets/ steht in .gitignore",
        "4. Alternative: Umgebungsvariablen STAC_USERNAME und STAC_PASSWORD",
        "Der Server kommt aus stac_import.STAC_HOSTS; 'hostname' wird nur verglichen."
    ],

    "INT": {
        "username": "USER INT",
        "password": "Password INT",
        "hostname": "sys-data.int.bgdi.ch"
    },
    "PROD": {
        "username": "USER PROD",
        "password": "Password PROD",
        "hostname": "data.geo.admin.ch"
    }
}
